# Anthropic API Key
ANTHROPIC_API_KEY=your_api_key_here

# OpenRouter (free-tier alternative to Anthropic — used by agent_openrouter.py
# and agent_simple.py). Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: override the default free-tier model (openai/gpt-oss-20b:free)
# OPENROUTER_MODEL=some-provider/some-model:free

# LangSmith (optional - for tracing and monitoring)
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=text2sql-deepagent

# Tavily API (optional - for web search capabilities)
TAVILY_API_KEY=your_tavily_api_key_here
